# ==============================================================================
# SMART ONLINE LUGGAGE TRANSPORTATION USING AI (FYP)
# Environment Configuration Template
# ==============================================================================

# Public Client Configuration (Safe for frontend exposure)
VITE_APP_NAME="SmartLuggage AI"
VITE_APP_VERSION="1.0.0"
VITE_DEFAULT_CURRENCY="PKR"
VITE_DEFAULT_COUNTRY="Pakistan"
VITE_DEFAULT_HUB_CITY="Islamabad"
VITE_ENABLE_DEBUG_LOGS="false"

# Machine Learning Service Configuration
# If ML_SERVICE_MODE is "local_embedded", frontend runs internal mathematical regression engine
# If "remote_api", requests are dispatched to trained Python ML service endpoint (Flask/FastAPI/ONNX)
ML_SERVICE_MODE="local_embedded"
ML_SERVICE_ENDPOINT="http://localhost:5000/api/v1/predict"

# ==============================================================================
# SECURE SERVER-ONLY VARIABLES (NEVER EXPOSE TO CLIENT/BROWSER CODE)
# ==============================================================================
# PORT=5000
# JWT_SECRET="super-secret-jwt-key-for-production-signing-change-me"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/smartluggage_db"
# ML_MODEL_PATH="./ml_models/random_forest_regressor_v1.pkl"
